---
layout: layouts/base.njk
ctaHeading: "Want help putting this into practice?"
ctaFlush: true
---
{%- set guides = collections.guide | byOrder %}
{%- set body = content | guideHtml %}
  <section class="page-hero">
    <div class="wrap">
      <p class="crumbs"><a href="/blog/">Guides</a></p>
      <h1 class="h1" style="max-width:820px">{{ title }}</h1>
      <p class="meta-line">By Clay Klaus-Wade &middot; {{ content | readingMinutes }} min read</p>
    </div>
  </section>
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <article class="article">
{{ body | beforeFirstH2 | safe }}
{% set source = "Guide: " ~ slug ~ " (intro)" %}{% set uid = "cap1" %}{% set slim = true %}{% include "partials/capture.njk" %}
{{ body | fromFirstH2 | safe }}
      </article>
      {%- set source = "Guide: " ~ slug ~ " (end)" %}{% set uid = "cap2" %}{% set slim = false %}
      {%- if site.subscribeEndpoint %}<div style="margin-top:48px">{% include "partials/capture.njk" %}</div>{% endif %}
      {%- set next = guides | nextAfter(page.url) %}
      <p style="margin-top:40px"><span class="muted small">Next guide</span><br><a class="link arrow" href="{{ next.url }}">{{ next.data.title }}</a></p>
    </div>
  </section>

  {% include "partials/cta.njk" %}
