<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{%- set pageTitle = fullTitle or (title ~ " · " ~ site.name) %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ description }}">
{%- if noindex %}
<meta name="robots" content="noindex">
{%- endif %}
{%- if not noindex %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{%- endif %}
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#16433e">
{%- if site.googleSiteVerification %}
<meta name="google-site-verification" content="{{ site.googleSiteVerification }}">
{%- endif %}
{%- if site.bingSiteVerification %}
<meta name="msvalidate.01" content="{{ site.bingSiteVerification }}">
{%- endif %}
{%- if site.gaMeasurementId %}
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag("js",new Date());gtag("config","{{ site.gaMeasurementId }}");
addEventListener("load",function(){(window.requestIdleCallback||setTimeout)(function(){var s=document.createElement("script");s.async=true;s.src="https://www.googletagmanager.com/gtag/js?id={{ site.gaMeasurementId }}";document.head.appendChild(s)})});</script>
{%- endif %}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/og/{{ page.url | ogSlug }}.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ pageTitle }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="preload" href="/fonts/newsreader-roman-v1.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/instrument-sans-v1.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ "/css/styles.css" | bust }}">
<script type="application/ld+json">
{{ schema | jsonLd(schemaNodes, schemaExtra) | safe }}
</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header class="site-header" id="top">
  <div class="wrap header-row">
    <a class="brand" href="/" aria-label="Full Panel, home">
      {% include "partials/mark.njk" %}
      <span class="wordmark">Full Panel</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav">
        {%- for item in site.nav %}
        <li><a href="{{ item.url }}"{% if page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
        {%- endfor %}
        <li><a class="btn btn-primary" href="/contact/">Book a free consult</a></li>
      </ul>
    </nav>
    <button class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="mobile-sheet">Menu</button>
  </div>
  <div class="mobile-sheet" id="mobile-sheet" hidden>
    <ul>
      <li><a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Home</a></li>
      {%- for item in site.nav %}
      <li><a href="{{ item.url }}"{% if page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
      {%- endfor %}
      <li><a class="btn btn-primary" href="/contact/">Book a free consult</a></li>
    </ul>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="lockup" href="/" style="text-decoration:none" aria-label="Full Panel, home">
          {% include "partials/mark.njk" %}
          <span><span class="wordmark">Full Panel</span><span class="tagline">{{ site.tagline }}</span></span>
        </a>
        <p class="small muted">Full Panel is a marketing and practice growth consultancy based in Philadelphia. It isn't a clinical practice and doesn't provide therapy.</p>
        <a class="social" href="{{ site.linkedin }}" target="_blank" rel="noopener" aria-label="Full Panel on LinkedIn">
          <svg viewBox="0 0 36 36" aria-hidden="true"><rect width="36" height="36" rx="9" fill="var(--pine)"/><path transform="translate(7.2 7.2) scale(.9)" fill="var(--on-pine)" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z"/></svg>
        </a>
      </div>
      <ul class="foot-links">
        {%- for item in site.nav %}{% if item.url != "/blog/" %}
        <li><a href="{{ item.url }}">{{ item.title }}</a></li>
        {%- endif %}{% endfor %}
        <li><a href="/contact/">Book a free consult</a></li>
      </ul>
      <div class="foot-links foot-group">
        <a href="/blog/">Guides</a>
        <ul>
          {%- for g in collections.guide | byOrder %}
          <li><a href="{{ g.url }}">{{ g.data.footerTitle or g.data.title }}</a></li>
          {%- endfor %}
        </ul>
      </div>
    </div>
    <div class="legal"><span>© {{ "now" | year }} Full Panel</span><span>fullpanel.co</span></div>
  </div>
</footer>

<script src="{{ "/js/main.js" | bust }}" defer></script>
</body>
</html>
