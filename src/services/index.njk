---
layout: layouts/base.njk
title: Services
ctaHeading: "Not sure where to start? That's what the consult is for."
ctaFlush: true
---
  <section class="hero" style="padding-bottom:48px">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:0">
        <p class="eyebrow">Services</p>
        <h1 class="h1">Everything a practice needs to be found, trusted and referred to.</h1>
        <p class="lede">Each service works on its own, but most engagements start with the audit so we spend your time and budget on what will actually move your caseload.</p>
      </div>
      <nav class="jump" aria-label="Jump to a service">
        {%- for s in services %}
        <a href="#{{ s.id }}">{{ s.name }}</a>
        {%- endfor %}
      </nav>
    </div>
  </section>
  <section class="section" style="padding-top:48px">
    <div class="wrap">
      {%- for s in services %}
      <article class="svc" id="{{ s.id }}">
        <div class="svc-head"><div class="num" aria-hidden="true">{{ loop.index }}</div><h2 class="h2">{{ s.name }}</h2>{% if s.start %}<span><span class="tag">Start here</span></span>{% endif %}</div>
        <div class="svc-body">
          <p class="lede" style="color:var(--ink)">{{ s.intro }}</p>
          <div><h4>What I do</h4><ul class="ticks">{% for d in s.does %}<li>{{ d }}</li>{% endfor %}</ul></div>
          <div><h4>What you get</h4><p>{{ s.get }}</p></div>
          {%- if s.ethics %}
          <aside class="ethics" aria-label="Ethics note"><span class="ethics-label">Ethics</span><p>{{ s.ethics }}</p></aside>
          {%- endif %}
        </div>
      </article>
      {%- endfor %}
    </div>
  </section>
  {% include "partials/cta.njk" %}
